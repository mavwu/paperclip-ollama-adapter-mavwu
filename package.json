{
  "name": "paperclip-ollama-adapter-mavwu",
  "version": "2.0.0",
  "description": "One-shot Paperclip external adapter for Ollama text inference",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./manifest": "./dist/manifest.js",
    "./server": "./dist/server/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CONFIGURATION.md",
    "CHANGELOG.md",
    "docs/phase-1-integration-findings-and-phase-2-poc.md",
    "docs/phase-2-live-inference-smoke.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-timeout=30000 tests/execute.test.mjs tests/boundaries.test.mjs tests/network.test.mjs tests/diagnostics.test.mjs tests/lifecycle.test.mjs tests/replay.test.mjs",
    "test:integration": "npm run build && node scripts/live-smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "paperclip",
    "paperclipai",
    "adapter",
    "ollama",
    "llm",
    "ai"
  ],
  "author": "Alfred Mavwu",
  "license": "MIT",
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.609.0",
    "axios": "^1.18.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  }
}
